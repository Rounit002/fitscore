<?xml version='1.0' encoding='utf-8'?>
<widget id="com.bitezsnap.app" version="1.0.2" android-versionCode="10002"
        xmlns="http://www.w3.org/ns/widgets"
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>bitezsnap</name>
    <description>AI nutrition label scanning and analysis.</description>
    <author email="dev@bitezsnap.app" href="https://bitezsnap.app">bitezsnap Team</author>

    <!-- The SPA is bundled into www/ from Frontend/dist (npm run sync:www). -->
    <content src="index.html" />

    <!-- XHR/fetch targets. The API is reached cross-origin from the app shell. -->
    <allow-navigation href="https://localhost/*" />
    <access origin="https://fitscore-rqgb.onrender.com/*" />
    <access origin="https://world.openfoodfacts.org/*" />
    <access origin="https://images.openfoodfacts.org/*" />
    <access origin="https://api.revenuecat.com/*" />
    <access origin="https://res.cloudinary.com/*" />
    <access origin="https://www.googleapis.com/*" />

    <!-- Open external links in the system browser, not the app WebView. -->
    <allow-intent href="https://fitscore-6hqp.onrender.com/*" />
    <allow-intent href="https://play.google.com/*" />
    <allow-intent href="https://accounts.google.com/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="market:*" />

    <preference name="Orientation" value="portrait" />
    <preference name="Fullscreen" value="false" />
    <!-- cordova-android 15 expects a #AARRGGBB literal; the legacy 0x form
         fails Android resource linking. -->
    <preference name="BackgroundColor" value="#ffffffff" />
    <!-- Camera preview + barcode scanning run through getUserMedia in the WebView. -->
    <preference name="AndroidInsecureFileModeEnabled" value="false" />

    <!-- Public Google Cloud project number for Play Integrity standard requests.
         Replace 0 for release builds after enabling Play Integrity in Play Console. -->
    <preference name="PlayIntegrityCloudProjectNumber" value="0" />
    <preference name="PlayIntegrityAllowedOrigins" value="https://fitscore-rqgb.onrender.com" />

    <!-- Android 12+ draws a system splash screen from these values; older
         releases fall back to a plain window background. Regenerate the PNGs
         with `npm run gen:res` after changing the logo.

         The splash icon is rasterised from resources/splash.png, whose mark is
         transparent and inset well inside the safe area — the system masks this
         icon to a circle and may crop further, so the mark must not approach
         the edges. The background below is the app's own light page colour, so
         the splash hands over to the first paint without a colour jump. -->
    <preference name="AndroidWindowSplashScreenBackground" value="#F5F5F5" />
    <preference name="AndroidWindowSplashScreenAnimatedIcon" value="res/android/splash/splash-icon.png" />
    <!-- Hold the splash for a fixed window instead of hiding it the moment the
         HTML finishes: `onPageFinished` fires before React has mounted, which
         otherwise flashes an empty shell. Cordova's own splash plugin is built
         into cordova-android 15 (SplashScreenPlugin), so no extra plugin is
         needed for these. -->
    <preference name="AutoHideSplashScreen" value="true" />
    <preference name="SplashScreenDelay" value="2000" />
    <preference name="FadeSplashScreen" value="true" />
    <preference name="FadeSplashScreenDuration" value="400" />

    <platform name="android">
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="36" />
        <preference name="android-compileSdkVersion" value="36" />
        <preference name="AndroidXEnabled" value="true" />

        <!-- Release transport and data-extraction policy. The network security
             file also protects devices whose vendor defaults are permissive. -->
        <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application">
            <application android:usesCleartextTraffic="false"
                         android:allowBackup="false"
                         android:fullBackupContent="false"
                         android:networkSecurityConfig="@xml/network_security_config" />
        </edit-config>
        <resource-file src="resources/android/xml/network_security_config.xml"
                       target="app/src/main/res/xml/network_security_config.xml" />
        <resource-file src="resources/android/build-extras.gradle"
                       target="app/build-extras.gradle" />
        <resource-file src="resources/android/proguard-rules.pro"
                       target="app/proguard-rules.pro" />

        <!-- Launcher icons. `foreground`+`background` build the adaptive icon
             used from Android 8; `src` is the legacy square fallback.
             `background` must be an image, not a colour: cordova-android emits
             @mipmap/ic_launcher_background, which a colour literal can't satisfy.

             All densities below are generated from resources/icon.png by
             `npm run gen:res`. The density-less entry is the default source of
             record for the mark; Cordova falls back to it only when a density
             is missing, which is why every bucket is still listed explicitly. -->
        <icon src="res/android/icon/xxxhdpi.png" />
        <icon density="ldpi" src="res/android/icon/ldpi.png"
              foreground="res/android/adaptive/ldpi-foreground.png"
              background="res/android/adaptive/ldpi-background.png" />
        <icon density="mdpi" src="res/android/icon/mdpi.png"
              foreground="res/android/adaptive/mdpi-foreground.png"
              background="res/android/adaptive/mdpi-background.png" />
        <icon density="hdpi" src="res/android/icon/hdpi.png"
              foreground="res/android/adaptive/hdpi-foreground.png"
              background="res/android/adaptive/hdpi-background.png" />
        <icon density="xhdpi" src="res/android/icon/xhdpi.png"
              foreground="res/android/adaptive/xhdpi-foreground.png"
              background="res/android/adaptive/xhdpi-background.png" />
        <icon density="xxhdpi" src="res/android/icon/xxhdpi.png"
              foreground="res/android/adaptive/xxhdpi-foreground.png"
              background="res/android/adaptive/xxhdpi-background.png" />
        <icon density="xxxhdpi" src="res/android/icon/xxxhdpi.png"
              foreground="res/android/adaptive/xxxhdpi-foreground.png"
              background="res/android/adaptive/xxxhdpi-background.png" />
        <!-- Serve the bundled SPA from https://localhost so the Cordova bridge
             is injected and getUserMedia is treated as a secure context. -->
        <preference name="scheme" value="https" />
        <preference name="hostname" value="localhost" />

        <config-file target="AndroidManifest.xml" parent="/manifest">
            <uses-permission android:name="android.permission.CAMERA" />
            <uses-permission android:name="android.permission.INTERNET" />
            <uses-feature android:name="android.hardware.camera" android:required="false" />
        </config-file>
    </platform>

    <plugin name="cordova-plugin-fitscore-play-integrity"
            spec="file:cordova-plugin-fitscore-play-integrity" />
</widget>
