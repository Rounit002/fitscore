# FitScan Cloudflare Pages Static Header Rules
# This file is automatically copied to Vite's build root (dist/_headers)
# Cloudflare Pages parses this on deployment to enforce optimized edge-caching policies.

# 1. Hashed Static Assets (Vite Compilations)
# These contain unique hashes and are safe to cache permanently at the edge and browser.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Access-Control-Allow-Origin: *

# 2. Public Standard Media & Static Assets
# Images, icons, and vector graphics should be cached for 30 days but revalidated if updated.
/*.png
  Cache-Control: public, max-age=2592000, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
/*.svg
  Cache-Control: public, max-age=2592000, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
/*.ico
  Cache-Control: public, max-age=2592000, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# 3. Main HTML Document (Core Application Payload)
# The entry point must NEVER be cached permanently. This forces the browser to check if a new
# build is available, preventing users from getting stuck with old cached application logic.
/
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

/index.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
