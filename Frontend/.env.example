# ── NutriScan frontend environment (Vite) ───────────────────────────────
# Copy to `.env` (or `.env.local`) and fill in. Only VITE_-prefixed vars are
# exposed to the client bundle.

# Backend API base URL (used by src/api/client.js).
VITE_API_URL=http://localhost:5000

# Legacy CdvPurchase billing validator base (cordova-plugin-purchase).
VITE_API_BASE_URL=http://localhost:3000

# ── RevenueCat (cordova-plugin-purchases) ───────────────────────────────
# Public Android SDK key from the RevenueCat dashboard
# (Project → API keys → "Public app-specific" Google key). Safe to ship.
VITE_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxx

# Entitlement identifier that grants premium (RevenueCat → Entitlements).
# Defaults to "premium" if unset.
VITE_REVENUECAT_ENTITLEMENT_ID=premium
