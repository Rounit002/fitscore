# ── bitezsnap mobile (Cordova) build env ────────────────────────────────
# Copy to `.env.cordova`. Loaded ONLY by `npm run build:cordova`
# (vite build --mode cordova), which is what mobile/ bundles into the APK.
#
# These values are baked into the shipped bundle, so never put secrets here.

# Marks the bundle as the packaged app. Enables HashRouter, the Bearer-token
# auth fallback, and native permission requests. Do not change.
VITE_BUILD_TARGET=cordova

# REQUIRED. Absolute, publicly reachable API base URL.
# The app is served from https://localhost, so a relative path or a localhost
# URL can never reach your backend from a phone.
VITE_MOBILE_API_URL=https://fitscore-rqgb.onrender.com

# Fallback for any code path that reads VITE_API_URL directly.
VITE_API_URL=https://fitscore-rqgb.onrender.com

# ── RevenueCat (in-app subscriptions, Android only) ─────────────────────
# Public Android SDK key (RevenueCat → API keys → public Google key).
# Safe to ship. Leave blank to ship without in-app purchases.
VITE_REVENUECAT_ANDROID_KEY=

# Entitlement identifier that grants premium. Must match the backend's
# REVENUECAT_ENTITLEMENT_ID exactly.
VITE_REVENUECAT_ENTITLEMENT_ID=premium
