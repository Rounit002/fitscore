# Runtime
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=
APP_URL=http://localhost:5173

# PostgreSQL (server-side only)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fitscore
DB_USER=postgres
DB_PASSWORD=replace_me
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# PEM contents of the database provider's CA certificate. Set this when the
# provider uses a private CA (otherwise SELF_SIGNED_CERT_IN_CHAIN on connect).
# Literal \n sequences are converted to real newlines.
DB_SSL_CA=

# Authentication (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET=replace_with_at_least_32_random_bytes
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
JWT_ISSUER=fitscore-api
JWT_AUDIENCE=fitscore-clients
BCRYPT_COST=12

# Abuse controls
GLOBAL_RATE_LIMIT=300
LOGIN_RATE_LIMIT=10
SIGNUP_RATE_LIMIT=5
PASSWORD_RESET_RATE_LIMIT=5
ANALYZE_IP_RATE_LIMIT=20
ANALYZE_USER_RATE_LIMIT=12

# Google OAuth / Play Billing / RTDN
GOOGLE_CLIENT_ID=
# One-line JSON service-account document used only by the backend.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Exact Android applicationId registered in Google Play Console.
GOOGLE_PACKAGE_NAME=com.bitezsnap.app
# Exact public RTDN webhook audience URL, for example https://api.example.com/billing/webhook.
GOOGLE_RTDN_AUDIENCE=
# Email identity expected in the verified Pub/Sub OIDC token.
GOOGLE_RTDN_SERVICE_ACCOUNT=
# Comma-separated Google Play subscription product IDs.
GOOGLE_SUBSCRIPTION_IDS=

# Play Integrity is enforced only when NODE_ENV=production and this flag is true.
PLAY_INTEGRITY_ENFORCEMENT_ENABLED=false
PLAY_INTEGRITY_MAX_TOKEN_AGE_MS=120000
# Optional comma-separated base64url SHA-256 signing certificate digests.
PLAY_INTEGRITY_ALLOWED_CERT_DIGESTS=

# AI and media providers
GEMINI_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payments and RevenueCat (all secret values stay on the backend)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# RevenueCat secret API key used for server-side subscriber lookups.
REVENUECAT_SECRET_KEY=
# Exact entitlement identifier configured in RevenueCat.
REVENUECAT_ENTITLEMENT_ID=premium
# Entire expected Authorization header value, including its scheme (for example Bearer ...).
REVENUECAT_WEBHOOK_AUTH=
# Shared HMAC signing secret configured for the RevenueCat webhook.
REVENUECAT_WEBHOOK_SIGNING_SECRET=
# Comma-separated RevenueCat application IDs accepted by the webhook.
REVENUECAT_APP_IDS=

# Transactional email
BREVO_API_KEY=
MAIL_FROM_ADDRESS=no-reply@bitezsnap.app
MAIL_FROM_NAME=bitezsnap
